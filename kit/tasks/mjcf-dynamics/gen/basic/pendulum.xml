<mujoco model="pendulum">
  <option timestep="0.002">
    <flag contact="disable" constraint="disable"/>
  </option>
  <worldbody>
    <body name="pole" pos="0 0 1">
      <joint name="hinge" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0 0 -0.5" size="0.03"/>
      <site name="tip" pos="0 0 -0.5"/>
    </body>
  </worldbody>
  <actuator>
    <motor name="torque" joint="hinge" gear="2" ctrlrange="-1 1"/>
  </actuator>
  <sensor>
    <jointpos joint="hinge"/>
    <framepos objtype="site" objname="tip"/>
  </sensor>
</mujoco>
