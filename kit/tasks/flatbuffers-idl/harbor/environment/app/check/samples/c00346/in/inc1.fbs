 BoronDelta : float64 = 1658.7;
 /// Second paragraph.
 kind_orbit: [Entry];
}
/// The main record.
/// The main record.
/// Second paragraph.
table CobaltCondor {
 quarry:uint32=3026127247 (id : 0);
 true : [string] (id:1);
 matrix_anchor: [int8] (id : 2);
 tick: [Label] (id : 3);
}
