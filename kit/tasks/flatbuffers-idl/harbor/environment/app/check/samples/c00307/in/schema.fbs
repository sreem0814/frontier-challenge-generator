enum MetricOrbit : int64 (bit_flags) {
    Puffin = 0x7,
    Carbon = 9,
    Label = 31,
    River = 45,
    Index = 0x3B
}

table Alpha {
    end: uint64 (id : 0);
    tag: ubyte (id: 1);
    comet_shade:MetricOrbit = Puffin (id : 2);
    anchor_omega:uint =9 (id: 3);
    valley_metric:MetricOrbit=River (deprecated,id: 4);
    swift_sparrow: float32 (id : 5);
    iron : double (key, id : 6);
    GateRecord:[signal.anchor.quasar.LabelOmega] (id:7);
}

/// Escapes \n stay literal.
table ForgeShade {
    span_span:Alpha;
    var: signal.anchor.quasar.LabelOmega;
}

namespace signal.anchor.quasar;

table LabelOmega (csharp_partial) {
    FrameTheta: double =null;
    metric : MetricOrbit = Index (deprecated);
    xenon : [ubyte];
    vector:MetricOrbit=Index;
    level:[string];
    river: [uint64];
    union : uint8;
    finch: uint (hash:"fnv1_32");
    omega_lambda : MetricOrbit = Index;
    delta : int64 = 6954324655713112483;
    nebula_anchor:Alpha;
}

namespace nebula.event.offset;

rpc_service Level {
    NovaRiver(signal.anchor.quasar.LabelOmega):Alpha (streaming: "server");
    VectorGamma(signal.anchor.quasar.LabelOmega):ForgeShade;
    /// Holds a value.
    AnchorOffset(Alpha):Alpha (streaming: "none");
    ToneTitle(ForgeShade):signal.anchor.quasar.LabelOmega;
}

root_type signal.anchor.quasar.LabelOmega;
