namespace span.matrix;

/// <b>html</b> & entities
/// Holds a value.
/// Unicode: été → λ
table Meadow91 {
 MatrixNebula:string (id: 2);
 summit_mode : [double] =[] (id : 3);
 kappa : [float] (id: 4);
 depth_lambda : [string] (id : 1);
 falcon_zinc: [packet.bridge.GardenLagoon] (id: 0);
}

namespace packet.bridge;

/// The main record.
/// Deprecated soon; see `next`.
/// Plain line
table GardenLagoon {
 /// The main record.
 orbit_market: uint16 = 35187;
 /// Value in [0, 1).
 kappa : [span.matrix.Meadow91] (required);
 DepotFrame : [ubyte] (offset64);
 falcon:[int32];
 osprey_lagoon : string;
 title: [uint32];
 finch_entry: span.matrix.Meadow91;
 level6:[GardenLagoon];
}

