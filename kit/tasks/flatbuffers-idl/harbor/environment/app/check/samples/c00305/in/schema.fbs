}

namespace gamma.argon;

enum SummitLimit : ulong (bit_flags) { Epoch = 16, Garden = 17, Total = 0x15, Tensor = 0x1E, Count = 50, Flavor = 51, Osprey = 54, Width = 61, Tone = 63 }

