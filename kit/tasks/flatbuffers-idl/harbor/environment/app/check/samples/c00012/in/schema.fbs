	///
	kestrel : [ubyte] (id: 2);
	vector : uint32 (id:3);
	nova : [string] (required,id:4);
}

namespace ;

table Lead27 {
	falcon:float;
	title_delta: ulong=328200658782442207;
}

/// Second paragraph.
/// Multi-word doc with punctuation: a, b; c!
enum BetaGate : int { NovaMill = -1, TOWER, Matrix }
table GlacierNickel {
