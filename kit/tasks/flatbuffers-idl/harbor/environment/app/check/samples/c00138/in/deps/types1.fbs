  XENON = 0,
  Stage = 10,
  LEAD,
  Total,
  ValleyZinc,
  Color = 14,
  NOVA,
  WIDTH,
  Prairie
}

/// Unicode: été → λ
///
table WidthQuarry {
  atoll:ulong=+0 (x_name);
  ///
  ///  Indented doc line.
  cobalt_header : [uint] = [];
  alpha_depth:[string];
  forest:[ubyte];
  tag:byte =69;
  osprey_phase: [float];
