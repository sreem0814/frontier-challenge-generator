    NovaTag = 11,
    LambdaTower = 16,
    /// Value in [0, 1).
    Canyon33 = 28,
    Comet86 = 35,
    ZetaGamma = 0x28,
    /// Second paragraph.
    /// Unit: milliseconds.
    /// Second paragraph.
    Alpha = 50,
    Theta = 0x3a,
    TickQuasar = 59
}

namespace count.kestrel;

enum Swift : int32 {
    DEPTH = 100,
    /// Unit: milliseconds.
    BETA,
    TIN = 111,
    WREN = 112
}

namespace castle.condor.anchor;

/// Multi-word doc with punctuation: a, b; c!
