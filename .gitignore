.env
*.env
tokens.json
denylist.txt

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Dry runs, prompt tries and selftests (README section 5)
data-dry/

# Pipeline runtime files in data/ (README section 8); seeds/, sources.tsv and the corpora stay tracked
data/STOP
data/.lock
data/channels.json
data/smoke.json
data/hints.json
data/usage.json
data/state.json
data/cost.jsonl
data/pipeline.log
data/runs/
data/spikes/
data/dashboard.html
data/dashboard.pid
data/dashboard.log

# Kit run logs and build output (make_zip.sh and l0_check.py write to tasks/<task>/build/)
kit/scripts/.runs.log
kit/tasks/*/build/
kit/tasks/*/jobs/

# Editor, OS and local Claude Code settings
.claude/settings.local.json
.vscode/
.idea/
*.swp
